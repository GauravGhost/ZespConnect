{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zesp Connect",
  "mainBinaryName": "zesp-connect",
  "version": "0.1.0",
  "identifier": "com.zesp.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Zesp Connect",
        "width": 880,
        "height": 730,
        "minWidth": 760,
        "minHeight": 520,
        "maxWidth": 880,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Gyanendra Kumar",
    "homepage": "https://github.com/GauravGhost/Zesp-Connect",
    "copyright": "Copyright © 2026 Gyanendra Kumar",
    "category": "Utility",
    "shortDescription": "Manage Android devices over adb and scrcpy.",
    "longDescription": "Zesp Connect is a cross-platform desktop app that manages Android devices over adb and scrcpy: device list and info, an installed-app manager, screen and camera mirroring, quick toggles, a device file browser, an adb shell and in-app logcat console, wireless pairing, and emulator (AVD) management.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
